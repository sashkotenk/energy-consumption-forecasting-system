APP_ENV=development
APP_SERVICE=api
APP_HOST=0.0.0.0
APP_PORT=8000
APP_HTTP_PORT=8080
POSTGRES_DB=energy_forecast
POSTGRES_USER=energy_forecast
POSTGRES_PASSWORD=energy_forecast
DATABASE_URL=postgresql+asyncpg://energy_forecast:energy_forecast@db:5432/energy_forecast
ARTIFACT_ROOT=/var/lib/energy-forecast/artifacts
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_UPLOAD_BYTES=314572800
LOG_LEVEL=INFO
CODE_COMMIT=local
JOB_MAX_ATTEMPTS=3
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_STALE_AFTER_SECONDS=60
JOB_POLL_INTERVAL_SECONDS=1
